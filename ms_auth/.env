SERVER_PORT=4001
SERVER_TIMEOUT_READ=3s
SERVER_TIMEOUT_WRITE=5s
SERVER_TIMEOUT_IDLE=5s
SERVER_TIMEOUT=5s
SERVER_DEBUG=true

POSTGRES_USER=api_user
POSTGRES_PASSWORD=api_password
POSTGRES_DB=api_db
POSTGRES_PORT=5432

DB_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_IDLE_TIME=15m

LIMITER_RPS=2
LIMITER_BURST=4
LIMITER_ENABLED=true

PRIVATE_KEY_PATH=/root/resources/keys/privateKey.pem
PUBLIC_KEY_PATH=/root/resources/keys/publicKey.pem

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_DB=0

CACHE_ADDR=${REDIS_HOST}:${REDIS_PORT}
CACHE_PASSWORD=${REDIS_PASSWORD}
CACHE_DB=${REDIS_DB}

JAEGER_PORT=jaeger:4318